{
  "name": "@criczen/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "tsx --env-file-if-exists=.env src/seed-cli.ts"
  },
  "dependencies": {
    "@criczen/shared": "workspace:*",
    "@electric-sql/pglite": "0.5.8",
    "@fastify/rate-limit": "11.2.1",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "postgres": "3.4.9",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
